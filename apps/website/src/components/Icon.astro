---
import { ICON, type IconName } from '@/icons';

interface Props {
  name: IconName;
  fill?: boolean;
  size?: string; // any CSS length; defaults to 1.15em (icon tracks type scale)
  class?: string;
  label?: string; // when set, the icon is meaningful and gets a title/role
}

const { name, fill = false, size, class: cls = '', label } = Astro.props;
const paths = ICON[name] ?? '';
const style = size ? `width:${size};height:${size}` : undefined;
---

<svg
  class:list={['i', { 'i--fill': fill }, cls]}
  viewBox="0 0 24 24"
  style={style}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={label ? `<title>${label}</title>${paths}` : paths}
/>
