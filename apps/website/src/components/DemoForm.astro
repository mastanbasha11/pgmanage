---
// Progressive-enhancement demo form. Posts to /api/demo (a Cloudflare Pages
// Function) as a normal form submit — works with JavaScript disabled. HTML5
// constraint validation runs client-side with no JS. Honeypot, no CAPTCHA.
interface Props {
  id?: string;
}
const { id = 'demo-form' } = Astro.props;
const tools = ['Excel or Google Sheets', 'A notebook / register', 'WhatsApp only', 'Another software', 'Nothing yet'];
---

<form class="df" id={id} method="POST" action="/api/demo" novalidate={false}>
  <!-- honeypot: real people never fill this; bots do -->
  <div class="hp" aria-hidden="true">
    <label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="grid">
    <div class="field">
      <label for={`${id}-name`}>Your name</label>
      <input id={`${id}-name`} name="name" type="text" required autocomplete="name" placeholder="e.g. Suresh Reddy" />
    </div>

    <div class="field">
      <label for={`${id}-phone`}>WhatsApp number</label>
      <div class="phone">
        <span class="cc" aria-hidden="true">+91</span>
        <input
          id={`${id}-phone`}
          name="phone"
          type="tel"
          required
          inputmode="numeric"
          pattern="[6-9][0-9]{9}"
          maxlength="10"
          autocomplete="tel-national"
          placeholder="10-digit mobile"
          aria-describedby={`${id}-phone-hint`}
        />
      </div>
      <p class="hint" id={`${id}-phone-hint`}>Indian mobile, no spaces. We message you here.</p>
    </div>

    <div class="field">
      <label for={`${id}-city`}>City</label>
      <input id={`${id}-city`} name="city" type="text" required autocomplete="address-level2" placeholder="e.g. Hyderabad" />
    </div>

    <div class="field">
      <label for={`${id}-beds`}>Beds</label>
      <input id={`${id}-beds`} name="beds" type="number" required min="1" max="5000" step="1" placeholder="e.g. 121" />
    </div>

    <div class="field">
      <label for={`${id}-properties`}>Properties</label>
      <input id={`${id}-properties`} name="properties" type="number" required min="1" max="200" step="1" placeholder="e.g. 1" />
    </div>

    <div class="field">
      <label for={`${id}-tool`}>What you use today</label>
      <select id={`${id}-tool`} name="current_tool" required>
        <option value="" disabled selected>Choose one</option>
        {tools.map((t) => <option value={t}>{t}</option>)}
      </select>
    </div>
  </div>

  <div class="actions">
    <button class="btn btn--primary" type="submit">Book my demo</button>
    <p class="fineprint">No card. We load your property before the call.</p>
  </div>
</form>

<style>
  .df {
    width: 100%;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s4);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .field label {
    font-size: var(--t-sm);
    font-weight: 700;
    color: var(--ink);
  }
  input,
  select {
    font: inherit;
    font-size: var(--t-base);
    min-height: 46px;
    padding: 0 14px;
    border: 1px solid var(--sageline);
    border-radius: var(--r-btn);
    background: #fff;
    color: var(--ink);
    width: 100%;
  }
  input::placeholder {
    color: var(--mut);
  }
  input:focus-visible,
  select:focus-visible {
    outline: 2px solid var(--forest);
    outline-offset: 1px;
    border-color: var(--forest);
  }
  /* Native invalid state after the browser marks it — text-carrying, not
     colour-only: a message is shown by the browser + the border thickens. */
  input:user-invalid,
  select:user-invalid {
    border-color: var(--alert);
    border-width: 2px;
  }
  .phone {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--sageline);
    border-radius: var(--r-btn);
    background: #fff;
    overflow: hidden;
  }
  .phone:focus-within {
    outline: 2px solid var(--forest);
    outline-offset: 1px;
    border-color: var(--forest);
  }
  .phone .cc {
    display: grid;
    place-items: center;
    padding-inline: 12px;
    background: var(--sage2);
    border-right: 1px solid var(--sageline);
    font-weight: 700;
    color: var(--mut);
    font-size: var(--t-sm);
  }
  .phone input {
    border: 0;
    border-radius: 0;
    outline: none;
  }
  .phone input:focus-visible {
    outline: none;
  }
  .hint {
    font-size: var(--t-xs);
    color: var(--mut);
  }
  .actions {
    margin-top: var(--s5);
    display: flex;
    align-items: center;
    gap: var(--s4);
    flex-wrap: wrap;
  }
  .fineprint {
    font-size: var(--t-sm);
    color: var(--mut);
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
